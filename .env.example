# Discord (Developer Portal)
DISCORD_TOKEN=                 # Bot tab -> Reset Token (SECRET — never paste in chat)
DISCORD_PUBLIC_KEY=            # General Information -> Public Key
DISCORD_APPLICATION_ID=        # General Information -> Application ID
DISCORD_GUILD_ID=              # right-click your server -> Copy Server ID (makes command registration instant)
ANNOUNCEMENT_CHANNEL_ID=       # right-click announcements channel -> Copy Channel ID

# Supabase
DATABASE_URL=                  # Project Settings -> Database -> Connection string -> Transaction pooler URI (port 6543)

# Bot settings
MJ_ROLE_NAME=MJ
LANGUAGE=fr
TIMEZONE=Europe/Paris          # timezone used to parse dates MJs type into forms
REMINDER_24H=true
REMINDER_1H=true
